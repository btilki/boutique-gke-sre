# Example: GitHub Actions WIF authentication (boutique-gke-sre)
# Copy relevant steps into .github/workflows/*.yml — not a runnable workflow alone.

name: example-wif-auth

on:
  workflow_dispatch:

permissions:
  contents: read
  id-token: write  # required for OIDC → WIF

jobs:
  gcp-auth-example:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Authenticate to Google Cloud (WIF)
        uses: google-github-actions/auth@v2
        with:
          workload_identity_provider: ${{ secrets.GCP_WORKLOAD_IDENTITY_PROVIDER }}
          service_account: ${{ secrets.GCP_SERVICE_ACCOUNT }}

      - name: Set up Cloud SDK
        uses: google-github-actions/setup-gcloud@v2

      - name: Verify identity
        run: gcloud auth print-access-token > /dev/null && gcloud config get-value account

      # Subsequent steps: docker push to Artifact Registry, cosign sign, etc.
