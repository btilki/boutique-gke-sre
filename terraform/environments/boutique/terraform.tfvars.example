# Copy to terraform.tfvars and adjust for your project.
# Never commit terraform.tfvars — it may contain environment-specific values.

project_id  = "boutique-gke"
region      = "europe-west1"
environment = "boutique"
domain      = "biroltilki.art"
cluster_name = "boutique-gke"
boutique_hostname = "boutique.biroltilki.art"
argocd_hostname   = "argocd.boutique.biroltilki.art"
deletion_protection = false

# Phase 3 — GitHub WIF (topic 07)
github_org  = "YOUR_GITHUB_ORG"   # e.g. "btilki"
github_repo = "boutique-gke-sre"

# Phase 3 — Binary Authorization (topic 08)
# Generate with: cosign generate-key-pair  (creates cosign.key + cosign.pub)
# Paste cosign.pub contents below. Never commit cosign.key.
# binary_authorization_enforcement_mode = "DRYRUN_AUDIT_LOG_ONLY"  # default; switch to ENFORCED_BLOCK_AND_AUDIT_LOG before topic 12
# cosign_public_key_pem = <<-EOT
# -----BEGIN PUBLIC KEY-----
# ...
# -----END PUBLIC KEY-----
# EOT
