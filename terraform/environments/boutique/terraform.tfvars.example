# Copy to terraform.tfvars and adjust for your project.
# Never commit terraform.tfvars — it may contain environment-specific values.

project_id  = "boutique-gke"
region      = "europe-west1"
environment = "boutique"
domain      = "biroltilki.art"
cluster_name = "boutique-gke"
boutique_hostname = "boutique.biroltilki.art"
argocd_hostname   = "argocd.boutique.biroltilki.art"
deletion_protection = false

# Phase 3 — GitHub WIF (topic 07)
github_org  = "YOUR_GITHUB_ORG"   # e.g. "btilki"
github_repo = "boutique-gke-sre"

# Phase 3 — Binary Authorization (topic 08)
# Generate with: cosign generate-key-pair  (creates cosign.key + cosign.pub)
# Paste cosign.pub contents below. Never commit cosign.key.
# binary_authorization_enforcement_mode = "DRYRUN_AUDIT_LOG_ONLY"  # bootstrap default (topic 08)
# binary_authorization_enforcement_mode = "ENFORCED_BLOCK_AND_AUDIT_LOG"  # post topic 16 — see docs/security/edge-hardening.md
# cosign_public_key_pem = <<-EOT
# -----BEGIN PUBLIC KEY-----
# ...
# -----END PUBLIC KEY-----
# EOT

# Phase 7+ — Argo CD edge hardening (post topic 16)
# enable_argocd_armor = true
# argocd_armor_allowed_cidrs = ["203.0.113.10/32"]  # optional office/VPN IP; empty = public + WAF

# Phase 9-C — Monitoring + Backup IaC (topic 19). Default false while project is torn down.
# enable_monitoring_iac = true
# pagerduty_service_key = ""  # set via TF_VAR_pagerduty_service_key or GSM — never commit
# enable_backup_iac = true
# backup_retain_days = 7
# backup_deactivated = false  # set true before teardown if backups must stop
